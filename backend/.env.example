# Copy to backend/.env and adjust as needed. docker compose reads a .env file in this same
# directory automatically and substitutes ${VAR} references in docker-compose.yml with it.

# MONGODB_URI: defaults to the bundled local `mongo` container (mongodb://mongo:27017) when unset,
# so `docker compose up` works with zero external accounts. To use a real MongoDB Atlas cluster
# instead, paste its SRV connection string here (each service picks its own logical database via
# spring.data.mongodb.database in backend/config-repo/{service}.yml, so one cluster covers all of them):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# JWT_SECRET: base64-encoded HMAC-SHA256 signing key seeded into Vault by docker/vault-init.sh.
# Optional for local dev only — if left unset, vault-init.sh silently falls back to a fixed dev
# default that is committed to this repo in plain text. Anyone who has read that file can forge a
# valid JWT for any user of any deployment that didn't override this. REQUIRED before any real/
# shared/production deployment: set this to a random value, e.g. `openssl rand -base64 32`.
# Also note: docker-compose.yml runs Vault in dev mode (in-memory, auto-unsealed, fixed root token
# VAULT_DEV_ROOT_TOKEN_ID) — that's a local-dev convenience, not something to deploy as-is; a real
# deployment needs a properly initialized/unsealed Vault (or another real secret store) instead.
# JWT_SECRET=

# FRONTEND_ORIGIN: the exact origin (scheme + host + port) the gateway's CORS filter allows.
# Defaults to http://localhost:3000, matching `npm run dev`'s default port. Set this when testing
# from a second device on the same network (e.g. scanning a device-pairing QR code from a phone) —
# the frontend must be opened as "http://<your-PC's-LAN-IP>:3000" on that device (not "localhost",
# which on a phone means the phone itself), and this must be set to that same origin or the gateway
# rejects every request with a CORS error. Find your LAN IP with `ipconfig` (Windows) / `ifconfig`
# or `ip addr` (macOS/Linux). See frontend/README.md's "Cross-device / LAN setup" section.
# FRONTEND_ORIGIN=http://10.242.248.71:3000
