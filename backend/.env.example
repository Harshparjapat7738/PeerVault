# Copy to backend/.env and adjust as needed. docker compose reads a .env file in this same
# directory automatically and substitutes ${VAR} references in docker-compose.yml with it.

# MONGODB_URI: defaults to the bundled local `mongo` container (mongodb://mongo:27017) when unset,
# so `docker compose up` works with zero external accounts. To use a real MongoDB Atlas cluster
# instead, paste its SRV connection string here (each service picks its own logical database via
# spring.data.mongodb.database in backend/config-repo/{service}.yml, so one cluster covers all of them):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# JWT_SECRET: base64-encoded HMAC-SHA256 signing key seeded into Vault by docker/vault-init.sh.
# Optional — a dev default is baked into vault-init.sh if this is left unset.
# JWT_SECRET=
